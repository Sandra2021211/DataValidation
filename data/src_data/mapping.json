{
  "table_mapping": {
    "source_table": "raw_student_scores.csv",
    "destination_table": "cleaned_student_scores.csv",
    "description": "Student score data mapping with standardized column names"
  },
  "column_mappings": {
    "NAME OF THE STUDENT": "name_of_the_student",
    "UNIVERSITY": "university",
    "PROGRAM NAME": "program_name",
    "Specialisation": "specialisation",
    "SEMESTER": "semester",
    "Domain": "domain",
    "GENERAL MANAGEMENT SCORE (OUT of 50)": "general_management_score",
    "Domain Specific SCORE (OUT 50)": "domain_specific_score",
    "TOTAL SCORE (OUT of 100)": "total_score",
    "RANK": "rank",
    "PERCENTILE": "percentile"
  },
  "validation_rules": {
    "primary_key": "name_of_the_student",
    "required_columns": [
      "name_of_the_student",
      "university",
      "program_name",
      "semester",
      "domain",
      "total_score",
      "rank"
    ],
    "data_types": {
      "name_of_the_student": "string",
      "university": "string",
      "program_name": "string",
      "specialisation": "string",
      "semester": "string",
      "domain": "string",
      "general_management_score": "float",
      "domain_specific_score": "float",
      "total_score": "float",
      "rank": "integer",
      "percentile": "float"
    },
    "sample_size": 5,
    "random_seed": 42
  }
}
