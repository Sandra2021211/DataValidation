{
  "table_mapping": {
    "source_table": "netflix_dataset_150.csv",
    "destination_table": "cleaned_netflix_dataset.csv",
    "description": "Netflix movies and TV shows data mapping"
  },
  "column_mappings": {
    "show_id": "show_id",
    "type": "content_type",
    "title": "title_name",
    "director": "director_name",
    "cast": "cast_members",
    "country": "country_origin",
    "date_added": "date_added_to_platform",
    "release_year": "year_released",
    "rating": "content_rating",
    "duration": "content_duration"
  },
  "validation_rules": {
    "primary_key": "show_id",
    "required_columns": [
      "show_id",
      "content_type",
      "title_name",
      "country_origin",
      "year_released"
    ],
    "data_types": {
      "show_id": "string",
      "content_type": "string",
      "title_name": "string",
      "director_name": "string",
      "cast_members": "string",
      "country_origin": "string",
      "date_added_to_platform": "date",
      "year_released": "integer",
      "content_rating": "string",
      "content_duration": "string"
    },
    "sample_size": 5,
    "random_seed": 101
  }
}
